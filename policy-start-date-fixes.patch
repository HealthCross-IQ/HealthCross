diff --git a/tests/test_api_census_summary.py b/tests/test_api_census_summary.py
index 2e165d1..8b7f944 100644
--- a/tests/test_api_census_summary.py
+++ b/tests/test_api_census_summary.py
@@ -38,3 +38,30 @@ def test_census_summary_404_without_census(client):
 
     resp = client.get(f"/cases/{case_id}/census-summary")
     assert resp.status_code == 404
+
+
+def test_census_age_uses_case_policy_start_date_when_file_has_no_eff_date(client):
+    resp = client.post(
+        "/cases",
+        json={
+            "broker_name": "Broker A",
+            "company_name": "Widgets LLC",
+            "industry": "trading",
+            "policy_start_date": "2020-01-01",
+        },
+    )
+    case_id = resp.json()["id"]
+    assert resp.json()["policy_start_date"] == "2020-01-01"
+
+    rows = [{"Gender": "M", "DOB": "1990-06-15", "Marital Status": "Single", "Relation": "Employee", "Nationality": "Indian"}]
+    census_df = pd.DataFrame(rows)
+    resp = client.post(
+        f"/cases/{case_id}/census",
+        files={"file": ("census.xlsx", _xlsx_bytes(census_df), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")},
+    )
+    assert resp.status_code == 200
+    record = resp.json()[0]
+    # Turns 30 on 2020-06-15; case's policy start predates that, so age at
+    # policy start is 29, not the member's current-day age.
+    assert record["age"] == 29
+    assert record["policy_start_date"] == "2020-01-01"
